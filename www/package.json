{
  "name": "elm-rust-tutorial",
  "version": "0.1.0",
  "description": "Elm & Rust wasm app built using Vite",
  "main": "index.js",
  "scripts": {
    "build": "npm-run-all --serial build-elm build-js modify-paths",
    "build-elm": "elm make src/Main.elm --optimize --output elm.js && replace '\\(this\\)\\);$' '(window));' elm.js",
    "build-js": "vite build",
    "dev": "vite",
    "lint": "elm-review",
    "modify-paths": "replace 'icons/' '' dist/index.html & replace 'icons/' '' dist/manifest.json",
    "start": "vite preview",
    "watch": "chokidar \"**/*.elm\" -c \"elm make src/Main.elm --output elm.js && replace '\\(this\\)\\);$' '(window));' elm.js\" --initial",
    "wasm": "wasm-pack build ./elm-rust-tutorial --target web"
  },
  "keywords": [
    "elm",
    "rust",
    "vite",
    "wasm"
  ],
  "author": "E M Thornber <mark.thornber@gmail.com>",
  "license": "(MIT OR Apache-2.0)",
  "dependencies": {
    "elm-rust-tutorial": "file:../pkg"
  },
  "devDependencies": {
    "chokidar-cli": "2.1.0",
    "elm-review": "^2.7.2",
    "elm-tooling": "^1.8.0",
    "hello-wasm-pack": "^0.1.0",
    "npm-run-all": "^4.1.5",
    "replace": "^1.1.5",
    "vite": "^6.2.2",
    "vite-plugin-elm": "^3.0.1",
    "vite-plugin-static-copy": "2.3.0",
    "vite-plugin-top-level-await":"^1.5.0",
    "vite-plugin-wasm": "^3.4.1"
  }
}
